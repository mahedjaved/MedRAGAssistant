# Copy this file to .env and fill in your keys
#   cp .env.example .env
PINECONE_API_KEY=your-pinecone-api-key-here
GROQ_API_KEY=your-groq-api-key-here
# ── Legacy fallback ───────────────────────────────────────
# Only needed if your existing .env uses GROK_API_KEY instead of GROQ_API_KEY
GROK_API_KEY=
# ── Optional API keys (reserved for future phases) ────────
GOOGLE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# ── RAGAS evaluation (required for Phase 2) ───────────
OPENAI_API_KEY=
# ── Pinecone ──────────────────────────────────────────────
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=medical-index
RELAXATION_TIME=1
# ── Service URLs (Docker defaults) ────────────────────────
# Qdrant and PostgreSQL URLs — only relevant when running via docker-compose
QDRANT_URL=http://qdrant:6333
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/medrag
# ── Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
UPLOADED_DOCS_DIR=./uploaded_docs